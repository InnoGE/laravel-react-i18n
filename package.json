{
  "name": "@innoge/laravel-react-i18n",
  "version": "3.0.0",
  "author": {
    "name": "Eugene Meles",
    "email": "xmelesx@gmail.com"
  },
  "contributors": [
    "InnoGE GmbH (https://innoge.de)"
  ],
  "keywords": [
    "vite-plugin",
    "vite-plugin-laravel",
    "laravel",
    "react",
    "i18n",
    "inertiajs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": "https://github.com/InnoGE/laravel-react-i18n",
  "license": "MIT",
  "description": "Allows to connect your `Laravel` Framework localization files with `React`.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "vite": [
        "./dist/vite.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "types:check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "php-array-reader": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
